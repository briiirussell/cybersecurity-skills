{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cybersecurity-skills",
          "informationUri": "https://github.com/briiirussell/cybersecurity-skills",
          "rules": [
            {
              "id": "secrets-audit/jwt-hmac-default/src/config.js/jwtSecret",
              "shortDescription": {
                "text": "JWT signing secret falls back to a hardcoded default when JWT_SECRET is unset or empty, and .env.example ships it empty"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1188"
                ],
                "skill": "secrets-audit"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1188.html"
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "Repository root"
          }
        }
      },
      "results": [
        {
          "ruleId": "secrets-audit/jwt-hmac-default/src/config.js/jwtSecret",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "Needs validation: JWT signing secret falls back to a hardcoded default when JWT_SECRET is unset or empty, and .env.example ships it empty. Blockers: Is JWT_SECRET set to a non-empty, high-entropy value in every deployed environment (production and staging), and has it ever run on the default?. Validation plan: In each running deployment, print only the length, not the value: node -e 'console.log((process.env.JWT_SECRET||\"\").length)'. Expect 32+; a 0 means the default is in effect. Confirm in the secret store that the value isn't the default from src/config.js:5. Then, against staging with a test account you own, sign an HS256 token {sub:<your test user id>} with the default and call GET /api/notes; expect 401. If either check fails, treat every token issued so far as forgeable: set a new secret (which invalidates all sessions) and review admin DELETE /api/admin/users/:id activity."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/config.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "partialFingerprints": {
            "cybersecuritySkills/v1": "secrets-audit/jwt-hmac-default/src/config.js/jwtSecret"
          },
          "properties": {
            "verdict": "needs_validation",
            "confidence": "medium",
            "skill": "secrets-audit"
          },
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/auth.js",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 23
                          }
                        },
                        "message": {
                          "text": "requireAuth reads the Bearer token from the Authorization header (any internet client)"
                        }
                      },
                      "kinds": [
                        "entrypoint"
                      ]
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/auth.js",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 27
                          }
                        },
                        "message": {
                          "text": "jwt.verify(token, config.jwtSecret): the HMAC key is the hardcoded default if JWT_SECRET is unset or empty"
                        }
                      },
                      "kinds": [
                        "propagation"
                      ]
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/auth.js",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 28
                          }
                        },
                        "message": {
                          "text": "req.user = { id: claims.sub, role: claims.role } is trusted by every notes route; requireAdmin (src/auth.js:36) looks up the role for claims.sub, so a forged sub of an admin's id passes the admin check"
                        }
                      },
                      "kinds": [
                        "sink"
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "relatedLocations": [
            {
              "id": 0,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/config.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5
                }
              },
              "message": {
                "text": "jwtSecret: process.env.JWT_SECRET || <hardcoded 8-char default>; || treats an empty string as unset"
              }
            },
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".env.example",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3
                }
              },
              "message": {
                "text": "JWT_SECRET= is empty, so copying the example as-is selects the hardcoded default"
              }
            },
            {
              "id": 2,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/auth.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18
                }
              },
              "message": {
                "text": "issueToken signs with the same config.jwtSecret, 7-day expiry (src/config.js:6)"
              }
            },
            {
              "id": 3,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/db.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8
                }
              },
              "message": {
                "text": "users.id is INTEGER PRIMARY KEY (sequential), so sub values are guessable"
              }
            }
          ]
        }
      ]
    }
  ]
}

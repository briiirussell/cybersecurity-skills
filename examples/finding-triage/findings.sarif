          "ruleId": "finding-triage/CWE-209/src/app.js/errorHandler",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "Global Express error handler returns err.message and err.stack to any client, pre-auth on any route. Severity low (likelihood high: Anonymous client can trigger it on any route with a malformed JSON body; no precondition beyond reaching the API; impact low: Discloses absolute install paths, module names, SQLite schema fragments, and (via /api/preview) whether internal hostnames resolve and their internal IP/port state; no credentials, tokens or user data)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 17
                }
              }
            }
          ],
